{
	"name": "pixentia",
	"description": "Professional developer asset optimization studio (WebP compressor, Base64 encoder, Combined Pipeline, and GIF to Spritesheet converter)",
	"author": "DrDisagree",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"build:electron": "tsc -b && vite build && electron-builder",
		"lint": "eslint .",
		"preview": "vite preview"
	},
	"build": {
		"appId": "com.pixentia.app",
		"productName": "Pixentia",
		"directories": {
			"output": "dist-electron-build",
			"buildResources": "build-resources"
		},
		"files": [
			"dist/**/*",
			"dist-electron/**/*"
		],
		"asarUnpack": [
			"**/node_modules/sharp/**/*",
			"**/node_modules/@img/**/*"
		],
		"win": {
			"target": [
				"nsis",
				"portable"
			]
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true
		},
		"mac": {
			"target": [
				"dmg",
				"zip"
			],
			"category": "public.app-category.developer-tools",
			"hardenedRuntime": true,
			"notarize": false
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Graphics"
		}
	},
	"dependencies": {
		"adm-zip": "^0.5.17",
		"archiver": "^8.0.0",
		"clsx": "^2.1.1",
		"fs-extra": "^11.3.5",
		"lucide-react": "^1.16.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"sharp": "^0.34.5",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/adm-zip": "^0.5.8",
		"@types/archiver": "^7.0.0",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.3.3",
		"autoprefixer": "^10.5.0",
		"electron": "^41.6.1",
		"electron-builder": "^26.8.1",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"postcss": "^8.5.14",
		"tailwindcss": "^3.4.19",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^5.4.11",
		"vite-plugin-electron": "^0.29.1",
		"vite-plugin-electron-renderer": "^0.14.7"
	}
}
